# =============================================================================
# Cloud Remote Linux Synchronizer - Configuration Template
# =============================================================================
# Copy this file to ~/.config/rclone-remote-syncer/config.env and edit it.
# This file is sourced by the sync scripts (bash-parseable variables).
#
# Format for each SYNC pair:
#   SYNC_N="<absolute-local-path>:<rclone-remote>:<remote-path>"
#
# The remote name must match what is configured in rclone.
# Run `rclone config` to add/edit remotes interactively.
# Run `rclone config show` to list existing remotes.
# =============================================================================

# ---------------------------------------------------------------------------
# Rclone remote name (as it appears in `rclone config show`)
# ---------------------------------------------------------------------------
RCLONE_REMOTE="myremote"

# ---------------------------------------------------------------------------
# Sync pairs (local absolute path : remote : remote sub-path)
# Add as many SYNC_N entries as needed (N = 1, 2, 3, ...).
# ---------------------------------------------------------------------------

SYNC_1="$HOME/Documents:myremote:Documents"
# SYNC_2="$HOME/Pictures:myremote:Pictures"
# SYNC_3="$HOME/Videos:remote:Videos"

# ---------------------------------------------------------------------------
# Rclone sync options
# ---------------------------------------------------------------------------
# --log-level: DEBUG | INFO | NOTICE | ERROR
RCLONE_LOG_LEVEL="INFO"

# Log file location (leave empty to log to stdout only)
RCLONE_LOG_FILE="$HOME/.config/rclone-remote-syncer/sync.log"

# Extra rclone flags appended to every sync call (space-separated)
RCLONE_EXTRA_FLAGS="--exclude='.git/**' --exclude='node_modules/**'"

# ---------------------------------------------------------------------------
# Sync mode
# "sync"   = one-way (local -> remote, remote-only files are deleted)
# "copy"   = one-way copy (remote-only files kept)
# "bisync" = two-way sync (requires rclone >= 1.58)
# ---------------------------------------------------------------------------
SYNC_MODE="bisync"

# ---------------------------------------------------------------------------
# Dry-run mode: set to "true" to preview without making changes
# ---------------------------------------------------------------------------
DRY_RUN="false"
